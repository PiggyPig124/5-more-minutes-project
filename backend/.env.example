# Local development defaults to SQLite and deterministic demo replies.
APP_ENV=development
DATABASE_URL=sqlite:///./anxin.db

# Required in production. Use a long random value and keep it server-side.
AUTH_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=86400

# Set DEMO_MODE=true to force the deterministic adapter. Without a model key,
# the API automatically uses deterministic_demo and labels each response.
DEMO_MODE=false
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
MODEL_TIMEOUT_SECONDS=45

# Optional semantic retrieval. Without this configuration retrieval is clearly
# labelled keyword-only. Choose a multilingual embedding model for Cantonese
# and Traditional Chinese. These credentials remain on the server.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=8
