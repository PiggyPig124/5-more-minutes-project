# Echo competition project only. No credentials belong in this template.
# from_env reads process variables; this file is NOT loaded automatically.
# Keep DEMO_MODE=true until region, workspace, model and protocol are confirmed.
DEMO_MODE=true
MODEL_BASE_URL=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_OUTPUT_TOKENS=1024
# Supply MODEL_API_KEY securely to the backend process yourself, outside this file.
# Existing code does not read DASHSCOPE_API_KEY; use MODEL_API_KEY.
# Do not inherit OPENAI_API_KEY/OPENAI_BASE_URL/OPENAI_MODEL from other projects.
# Pick the region that owns the competition key; do not infer it from location/key.
# Beijing shared: https://dashscope.aliyuncs.com/compatible-mode/v1
# Singapore shared: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Hong Kong shared: https://cn-hongkong.dashscope.aliyuncs.com/compatible-mode/v1
# Workspace-only (replace WorkspaceId only with the confirmed public space ID):
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# https://{WorkspaceId}.cn-hongkong.maas.aliyuncs.com/compatible-mode/v1
# Select ONE competition model exactly as granted:
# qwen3.8-27b | qwen3.7-flash-2026-07-15 | qwen3.8-flash
# kimi-k3 | deepseek-v4-flash-0731
# No embeddings are enabled by this template.
# Read docs/COMPETITION_MODEL_ACCEPTANCE_ZH.md before setting DEMO_MODE=false.
